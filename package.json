{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "E-commerce API with Fastify",
  "main": "./src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "seed": "node src/services/seed.js",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:e2e": "NODE_ENV=test vitest run test/routes/*.e2e.test.js",
    "test:e2e:watch": "NODE_ENV=test vitest watch test/routes/*.e2e.test.js",
    "test:coverage:detailed": "NODE_ENV=test vitest run --coverage --coverage.reporter=html --coverage.reporter=text --coverage.reporter=json --coverage.reporter=lcov test/routes/*.test.js",
    "clean": "rm -rf coverage .vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage test/routes/*.test.js",
    "test:coverage:all": "NODE_ENV=test vitest run --coverage test/**/*.test.js",
    "test:coverage:edge": "NODE_ENV=test vitest run --coverage test/**/*.edge-cases.test.js",
    "test:coverage:html": "NODE_ENV=test vitest run --coverage test/**/*.test.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --no-warn-ignored"
    ]
  },
  "keywords": [
    "ecommerce",
    "fastify",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@elastic/elasticsearch": "^9.3.4",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@libsql/client": "^0.17.2",
    "@vitest/ui": "^4.1.4",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-elasticsearch": "^8.1.0",
    "pino-pretty": "^13.1.3",
    "readline-sync": "^1.4.10",
    "source-map-support": "^0.5.21",
    "umzug": "^3.8.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/uuid": "^11.0.0",
    "@vitest/coverage-istanbul": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vitest": "^4.1.4"
  }
}