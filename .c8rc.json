{
  "include": [
    "src/**/*.js",
    "db.js",
    "schema.js",
    "services/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "test",
    "coverage",
    "**/*.config.js",
    "src/services/rateLimiting.js",
    "src/services/authMiddleware.js",
    "src/services/seed.js"
  ],
  "reporter": ["text", "html", "lcov"],
  "all": true,
  "clean": true,
  "lines": 0,
  "functions": 0,
  "branches": 0,
  "statements": 0
}